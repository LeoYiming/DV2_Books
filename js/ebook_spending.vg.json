{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "How Are E-book Transactions Distributed by Spending Range?",
    "subtitle": "Share of e-book transactions by transaction value, 2017-2022"
  },

  "width": 600,
  "height": 350,

  "data": {
    "url": "data/ebook_spending.csv"
  },

  "transform": [
    {
      "calculate": "datum.Spending_Range === 'MYR1-MYR20' ? 1 : datum.Spending_Range === 'MYR20-MYR40' ? 2 : datum.Spending_Range === 'MYR40-MYR60' ? 3 : datum.Spending_Range === 'MYR60-MYR80' ? 4 : datum.Spending_Range === 'MYR80-MYR100' ? 5 : 6",
      "as": "Sort_Order"
    }
  ],

  "mark": {
    "type": "bar"
  },

  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": 0
      }
    },

    "y": {
      "field": "Percentage",
      "type": "quantitative",
      "title": "Share of Transactions",
      "stack": "normalize",
      "scale": {
        "domain": [0, 1]
      },
      "axis": {
        "format": "%"
      }
    },

    "color": {
      "field": "Spending_Range",
      "type": "ordinal",
      "title": "Spending Range",
      "sort": [
        "MYR1-MYR20",
        "MYR20-MYR40",
        "MYR40-MYR60",
        "MYR60-MYR80",
        "MYR80-MYR100",
        "MYR100+"
      ],
      "scale": {
        "scheme": "viridis"
      }
    },

    "order": {
      "field": "Sort_Order",
      "type": "quantitative"
    },

    "tooltip": [
      {
        "field": "Year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "Spending_Range",
        "type": "ordinal",
        "title": "Transaction Value"
      },
      {
        "field": "Percentage",
        "type": "quantitative",
        "title": "Reported Share (%)",
        "format": ".0f"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },

    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#424B52",
      "titleColor": "#424B52",
      "gridColor": "#E5E9EC",
      "domainColor": "#A8B0B5",
      "tickColor": "#A8B0B5"
    },

    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    },

    "title": {
      "font": "Arial",
      "subtitleFont": "Arial"
    }
  }
}