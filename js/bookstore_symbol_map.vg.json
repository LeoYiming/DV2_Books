{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Which Cities Have More Bookstores?",
    "subtitle": "Bookstores with city information recorded in OpenStreetMap"
  },

  "width": 700,
  "height": 400,

  "projection": {
    "type": "mercator"
  },

  "layer": [
    {
      "data": {
        "url": "data/administrative_1_state.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "white",
        "strokeWidth": 1
      }
    },

    {
      "data": {
        "url": "data/malaysia_bookstores.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "transform": [
        {
          "calculate": "datum.properties['addr:city']",
          "as": "City"
        },
        {
          "calculate": "datum.geometry.coordinates[0]",
          "as": "Longitude"
        },
        {
          "calculate": "datum.geometry.coordinates[1]",
          "as": "Latitude"
        },
        {
          "filter": "isValid(datum.City)"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "Bookstores"
            },
            {
              "op": "mean",
              "field": "Longitude",
              "as": "Longitude"
            },
            {
              "op": "mean",
              "field": "Latitude",
              "as": "Latitude"
            }
          ],
          "groupby": [
            "City"
          ]
        }
      ],

      "mark": {
        "type": "circle",
        "opacity": 0.7,
        "stroke": "white",
        "strokeWidth": 1
      },

      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "Bookstores",
          "type": "quantitative",
          "title": "Recorded Bookstores"
        },

        "tooltip": [
          {
            "field": "City",
            "type": "nominal",
            "title": "City"
          },
          {
            "field": "Bookstores",
            "type": "quantitative",
            "title": "Recorded Bookstores"
          }
        ]
      }
    }
  ]
}