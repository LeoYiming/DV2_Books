{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
  "text": "How Have Malaysia's Book Categories Changed?",
  "subtitle": "Number of titles collected by the National Library of Malaysia, 2013-2022"
  },

  "width": 650,
  "height": 350,

  "data": {
    "url": "data/book_categories.csv"
  },

  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 55
    },
    "strokeWidth": 2.5
  },

  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": 0
      }
    },

    "y": {
      "field": "Titles",
      "type": "quantitative",
      "title": "Number of Titles",
      "scale": {
        "zero": true
      }
    },

    "color": {
      "field": "Category",
      "type": "nominal",
      "title": "Book Category",
      "scale": {
        "domain": [
          "Adult Books",
          "Children's Books",
          "Textbooks"
        ],
        "range": [
          "#6C5B7B",
          "#D89B45",
          "#3F8C8E"
        ]
      }
    },

    "tooltip": [
      {
        "field": "Year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "Category",
        "type": "nominal",
        "title": "Category"
      },
      {
        "field": "Titles",
        "type": "quantitative",
        "title": "Titles",
        "format": ","
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },

    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#424B52",
      "titleColor": "#424B52",
      "gridColor": "#E5E9EC",
      "domainColor": "#A8B0B5",
      "tickColor": "#A8B0B5"
    },

    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}