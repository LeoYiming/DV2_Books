{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "What Does Malaysia Publish?",
    "subtitle": "Selected book subject areas recorded by the National Library of Malaysia, 2013-2022",
    "anchor": "start"
  },

  "width": 650,
  "height": 350,

  "data": {
    "url": "data/subject_year.csv"
  },

  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 0.7
  },

  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": 0
      }
    },

    "y": {
      "field": "Subject",
      "type": "nominal",
      "title": "Subject Area",
      "sort": [
        "Language",
        "Literature",
        "Religion",
        "Education",
        "Mathematics",
        "Natural Science",
        "Economy",
        "Technology, Engineering, Industry"
      ],
      "axis": {
        "labelLimit": 220
      }
    },

    "color": {
      "field": "Titles",
      "type": "quantitative",
      "title": "Number of Titles",
      "scale": {
        "scheme": "browns"
      },
      "legend": {
        "gradientLength": 180
      }
    },

    "tooltip": [
      {
        "field": "Year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "Subject",
        "type": "nominal",
        "title": "Subject Area"
      },
      {
        "field": "Titles",
        "type": "quantitative",
        "title": "Titles",
        "format": ","
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },

    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#424B52",
      "titleColor": "#424B52",
      "grid": false,
      "domainColor": "#A8B0B5",
      "tickColor": "#A8B0B5"
    },

    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#424B52",
      "titleColor": "#424B52"
    },

    "title": {
      "font": "Arial",
      "subtitleFont": "Arial"
    }
  }
}