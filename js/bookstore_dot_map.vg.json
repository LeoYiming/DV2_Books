{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Where Are Malaysia's Bookstores Located?",
    "subtitle": "Recorded bookstore locations from OpenStreetMap"
  },

  "width": 700,
  "height": 400,

  "projection": {
    "type": "mercator"
  },

  "layer": [
    {
      "data": {
        "url": "data/administrative_1_state.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#f1f3f4",
        "stroke": "white",
        "strokeWidth": 1
      }
    },

    {
      "data": {
        "url": "data/malaysia_bookstores.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "transform": [
        {
          "calculate": "datum.geometry.coordinates[0]",
          "as": "Longitude"
        },
        {
          "calculate": "datum.geometry.coordinates[1]",
          "as": "Latitude"
        }
      ],

      "mark": {
        "type": "circle",
        "size": 30,
        "opacity": 0.55,
        "color": "#5B5F97",
        "stroke": "white",
        "strokeWidth": 0.4
      },

      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "Bookstore"
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "Place": "Kuala Lumpur",
            "Longitude": 101.6869,
            "Latitude": 3.139
          },
          {
            "Place": "George Town",
            "Longitude": 100.3327,
            "Latitude": 5.4141
          },
          {
            "Place": "Johor Bahru",
            "Longitude": 103.7414,
            "Latitude": 1.4927
          },
          {
            "Place": "Kuching",
            "Longitude": 110.3592,
            "Latitude": 1.5533
          },
          {
            "Place": "Kota Kinabalu",
            "Longitude": 116.0735,
            "Latitude": 5.9804
          }
        ]
      },

      "mark": {
        "type": "point",
        "filled": true,
        "size": 28,
        "color": "#222222"
      },

      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "Place": "Kuala Lumpur",
            "Longitude": 101.6869,
            "Latitude": 3.139
          },
          {
            "Place": "George Town",
            "Longitude": 100.3327,
            "Latitude": 5.4141
          },
          {
            "Place": "Johor Bahru",
            "Longitude": 103.7414,
            "Latitude": 1.4927
          },
          {
            "Place": "Kuching",
            "Longitude": 110.3592,
            "Latitude": 1.5533
          },
          {
            "Place": "Kota Kinabalu",
            "Longitude": 116.0735,
            "Latitude": 5.9804
          }
        ]
      },

      "mark": {
        "type": "text",
        "dx": 6,
        "dy": -6,
        "align": "left",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#333333"
      },

      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },

        "text": {
          "field": "Place"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "title": {
      "font": "Arial",
      "subtitleFont": "Arial"
    }
  }
}