{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Where Are Recorded Bookstores Most Concentrated?",
    "subtitle": "Spatial concentration of OpenStreetMap bookstore records across the Klang Valley"
  },

  "width": 700,
  "height": 420,

  "projection": {
    "type": "mercator",
    "center": [101.55, 3.15],
    "scale": 30000
  },

  "layer": [
    {
      "data": {
        "url": "data/administrative_1_state.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#f1f3f4",
        "stroke": "white",
        "strokeWidth": 1,
        "clip": true
      }
    },

    {
      "data": {
        "url": "data/malaysia_bookstores.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "transform": [
        {
          "calculate": "datum.geometry.coordinates[0]",
          "as": "Longitude"
        },
        {
          "calculate": "datum.geometry.coordinates[1]",
          "as": "Latitude"
        },
        {
          "filter": "datum.Longitude >= 100.95 && datum.Longitude <= 102.05 && datum.Latitude >= 2.65 && datum.Latitude <= 3.65"
        },
        {
          "bin": {
            "step": 0.05
          },
          "field": "Longitude",
          "as": [
            "Longitude_Start",
            "Longitude_End"
          ]
        },
        {
          "bin": {
            "step": 0.05
          },
          "field": "Latitude",
          "as": [
            "Latitude_Start",
            "Latitude_End"
          ]
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "Bookstores"
            }
          ],
          "groupby": [
            "Longitude_Start",
            "Longitude_End",
            "Latitude_Start",
            "Latitude_End"
          ]
        }
      ],

      "mark": {
        "type": "rect",
        "opacity": 0.82,
        "stroke": "white",
        "strokeWidth": 0.5,
        "clip": true
      },

      "encoding": {
        "longitude": {
          "field": "Longitude_Start",
          "type": "quantitative"
        },

        "longitude2": {
          "field": "Longitude_End"
        },

        "latitude": {
          "field": "Latitude_Start",
          "type": "quantitative"
        },

        "latitude2": {
          "field": "Latitude_End"
        },

        "color": {
          "field": "Bookstores",
          "type": "quantitative",
          "title": "Recorded Bookstores",
          "scale": {
            "scheme": "purples"
          }
        },

        "tooltip": [
          {
            "field": "Bookstores",
            "type": "quantitative",
            "title": "Recorded Bookstores"
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "Place": "Kuala Lumpur",
            "Longitude": 101.6869,
            "Latitude": 3.139
          },
          {
            "Place": "Petaling Jaya",
            "Longitude": 101.6449,
            "Latitude": 3.1073
          },
          {
            "Place": "Shah Alam",
            "Longitude": 101.5328,
            "Latitude": 3.0738
          },
          {
            "Place": "Klang",
            "Longitude": 101.4456,
            "Latitude": 3.0449
          }
        ]
      },

      "mark": {
        "type": "point",
        "filled": true,
        "size": 35,
        "color": "#333333"
      },

      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "Place": "Kuala Lumpur",
            "Longitude": 101.6869,
            "Latitude": 3.139
          },
          {
            "Place": "Petaling Jaya",
            "Longitude": 101.6449,
            "Latitude": 3.1073
          },
          {
            "Place": "Shah Alam",
            "Longitude": 101.5328,
            "Latitude": 3.0738
          },
          {
            "Place": "Klang",
            "Longitude": 101.4456,
            "Latitude": 3.0449
          }
        ]
      },

      "mark": {
        "type": "text",
        "dx": 7,
        "dy": -7,
        "align": "left",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#333333"
      },

      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },

        "text": {
          "field": "Place"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    },

    "title": {
      "font": "Arial",
      "subtitleFont": "Arial"
    }
  }
}